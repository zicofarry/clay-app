# Clay Email Service — Environment Variables
# Copy to .env for local development (never commit .env)

# ACS (Azure Communication Services) — optional, logs to console if not set
# ACS_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-base64-key
# ACS_EMAIL_FROM=DoNotReply@your-domain.com

# Redis (for template cache, rate limiting)
REDIS_URL=redis://localhost:6373/0

# Optional (defaults shown)
PORT=8080
