# Clay SMS Service — Environment Variables
# Copy to .env for local development (never commit .env)

# ACS (Azure Communication Services) — optional, logs to console if not set
# ACS_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-base64-key
# ACS_SMS_FROM=+1234567890

# Redis (for rate limiting & OTP blacklist)
REDIS_URL=redis://localhost:9021/0
# REDIS_ADDR=localhost:6379   # fallback if REDIS_URL not set

# Optional (defaults shown)
PORT=8021
