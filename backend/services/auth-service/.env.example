# Clay Auth Service — Environment Variables
# Copy to .env for local development (never commit .env)

# Required
JWT_SECRET=your-super-secret-key-min-32-chars

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=clay
DB_PASSWORD=clay
DB_NAME=clay
DB_SSL_MODE=disable

# Redis (for OTP store & rate limiting)
# REDIS_URL takes precedence over REDIS_ADDR
# REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=localhost:6379

# Internal services (for OTP delivery)
# SMS_SERVICE_URL=http://clay-sms-service:8021
# EMAIL_SERVICE_URL=http://clay-email-service:8080

# Optional (defaults shown)
PORT=8080
JWT_ISSUER=clay-auth-service
