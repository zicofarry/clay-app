        "url": {
          "raw": "{{base_url}}/auth/logout-all",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "logout-all"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
