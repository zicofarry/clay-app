  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"budi\",\n  \"phone\": \"+6281234567890\",\n  \"email\": \"budi@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"user\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Request OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/request-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "request-otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+6281234567890\",\n  \"type\": \"registration\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/verify-otp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "verify-otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+6281234567890\",\n  \"otp_code\": \"123456\",\n  \"type\": \"registration\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login (Password)",
      "request": {
        "method": "POST",
        "header": [
