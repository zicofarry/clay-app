            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login",
            "otp"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+6281234567890\",\n  \"otp_code\": \"123456\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
