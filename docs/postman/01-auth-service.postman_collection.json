          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"Password123!\",\n  \"identifier\": \"+6281234567890\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login (OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login/otp",
