          "raw": "{\n  \"type\": \"credit_card\",\n  \"card_number\": \"4111111111111111\",\n  \"card_holder\": \"Budi Santoso\",\n  \"expiry_month\": \"12\",\n  \"expiry_year\": \"2028\",\n  \"cvv\": \"123\"\n}"
