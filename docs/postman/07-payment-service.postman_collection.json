  "item": [
    {
      "name": "List Payment Methods",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/payment-methods",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payment-methods"
          ]
        }
      }
    },
    {
