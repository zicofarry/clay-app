  "item": [
    {
      "name": "Email Delivery Webhook",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/webhooks/email/delivery",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "webhooks",
            "email",
            "delivery"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"delivered\",\n  \"message_id\": \"msg_abc123\",\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"signature\": \"sha256=abc...\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
