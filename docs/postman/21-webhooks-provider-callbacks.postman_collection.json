            "sms",
            "delivery"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event\": \"delivered\",\n  \"message_id\": \"sms_xyz789\",\n  \"to\": \"+6281234567890\",\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"signature\": \"sha256=xyz...\"\n}"
