          "// Set auth_token variable after login"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Get My Login Attempts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/login-attempts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "login-attempts"
          ]
        }
      }
    },
    {
      "name": "[Admin] List All Login Attempts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/login-attempts?page=1&limit=20",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "login-attempts"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "[Admin] List Fraud Flags",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/fraud-flags?status=open",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "fraud-flags"
          ],
          "query": [
            {
              "key": "status",
              "value": "open"
            }
          ]
        }
      }
    },
    {
      "name": "[Admin] Create Fraud Flag",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/fraud-flags",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "fraud-flags"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"reason\": \"Suspicious activity\",\n  \"severity\": \"high\",\n  \"evidence\": \"Multiple failed login attempts\"\n}"
        }
      }
    },
    {
      "name": "[Admin] Get Fraud Flag",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/fraud-flags/{{flag_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "fraud-flags",
            "{{flag_id}}"
          ]
        }
      }
    },
    {
      "name": "[Admin] Resolve Fraud Flag",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/fraud-flags/{{flag_id}}/resolve",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "fraud-flags",
            "{{flag_id}}",
            "resolve"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resolution\": \"false_positive\",\n  \"notes\": \"Verified legitimate user\"\n}"
        }
      }
    },
    {
      "name": "[Admin] List IP Blacklist",
      "request": {
