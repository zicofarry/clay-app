          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/security/admin/ip-blacklist",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "admin",
            "ip-blacklist"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ip_address\": \"192.168.1.100\",\n  \"reason\": \"DDoS attempt\",\n  \"expires_at\": \"2027-01-01T00:00:00Z\"\n}"
        }
      }
    },
    {
      "name": "[Admin] Remove IP from Blacklist",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
