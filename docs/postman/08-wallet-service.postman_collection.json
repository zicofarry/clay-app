  "item": [
    {
      "name": "Get Wallet Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/wallet",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wallet"
          ]
        }
      }
    },
    {
      "name": "Top Up Wallet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/wallet/topup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wallet",
            "topup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 100000,\n  \"payment_method\": \"credit_card\",\n  \"payment_method_id\": \"{{method_id}}\"\n}"
        }
      }
    },
    {
      "name": "[Webhook] Top Up Callback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/wallet/topup/callback",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wallet",
            "topup",
            "callback"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaction_id\": \"{{transaction_id}}\",\n  \"status\": \"success\",\n  \"amount\": 100000,\n  \"signature\": \"abc123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Transfer Wallet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/wallet/transfer",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wallet",
            "transfer"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient_phone\": \"+6289876543210\",\n  \"amount\": 50000,\n  \"note\": \"Bayar utang\"\n}"
        }
      }
    },
    {
